/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

/* 全局按钮点击反馈 */
.button-hover {
  opacity: 0.72 !important;
}

button::after{
  border: none;
}


page {
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}