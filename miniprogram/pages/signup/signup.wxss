.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 30rpx;
}

.room-header {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.room-name {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #c9a84c;
  margin-bottom: 16rpx;
}

.room-meta {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 8rpx;
}

.leader-bar {
  margin-bottom: 20rpx;
}

.lock-btn {
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 20rpx 0;
}

.lockbtn {
  background: #3a1a1a;
  color: #cf6679;
}

.unlockbtn {
  background: #1a3a2a;
  color: #4caf82;
}

.signup-action {
  margin-bottom: 24rpx;
}

.signup-btn {
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
}

.already-signed {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.already-signed text {
  font-size: 28rpx;
  color: #4caf82;
}

.cancel-btn {
  background: #3a1a1a;
  color: #cf6679;
  font-size: 26rpx;
  border-radius: 10rpx;
  border: none;
  padding: 12rpx 24rpx;
}

.form {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 10rpx;
}

.input {
  background: #1a1a2e;
  border: 1rpx solid #2a2a4a;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e0d5b0;
  width: 100%;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.list-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #c9a84c;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  color: #666688;
  font-size: 28rpx;
  margin-top: 40rpx;
}

.signup-card {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rank {
  font-size: 36rpx;
  font-weight: bold;
  color: #c9a84c;
  width: 50rpx;
  text-align: center;
}

.char-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #e0d5b0;
}

.job {
  display: block;
  font-size: 24rpx;
  color: #8888aa;
  margin-top: 6rpx;
}

.remark {
  display: block;
  font-size: 22rpx;
  color: #666688;
  margin-top: 6rpx;
}

.card-actions {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  background: #2a2a4a;
  color: #c9a84c;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
  padding: 10rpx 18rpx;
  min-width: 0;
}

.kick {
  background: #3a1a1a;
  color: #cf6679;
}