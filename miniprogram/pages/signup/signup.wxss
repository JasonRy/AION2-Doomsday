.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 12rpx;
  box-sizing: border-box;
  width: 100%;
}

.room-header {
  background: linear-gradient(135deg, #1e1a0e, #16213e);
  border: 2rpx solid #c9a84c;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 16rpx;
}

.room-name {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #c9a84c;
  margin-bottom: 16rpx;
}

.room-meta {
  display: block;
  font-size: 26rpx;
  color: #9999bb;
  margin-bottom: 8rpx;
}

.leader-bar {
  margin-bottom: 20rpx;
  display: flex;
  gap: 16rpx;
}

.leader-bar .lock-btn {
  flex: 1;
}

.end-btn {
  flex-shrink: 0;
  background: #3a1a1a;
  color: #cf6679;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 20rpx 28rpx;
}

.lock-btn {
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
  padding: 20rpx 0;
}

.lockbtn {
  background: #3a1a1a;
  color: #cf6679;
}

.unlockbtn {
  background: #1a3a2a;
  color: #4caf82;
}

.signup-action {
  margin-bottom: 24rpx;
}

.signup-btn-row {
  display: flex;
  gap: 16rpx;
}

.pick-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.signup-btn {
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
  margin-bottom: 0;
}

.pick-btn {
  flex: 1;
  background: #16213e;
  color: #c9a84c;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid #c9a84c;
}

.already-signed {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.already-signed text {
  font-size: 28rpx;
  color: #4caf82;
}

.cancel-btn {
  background: #3a1a1a;
  color: #cf6679;
  font-size: 26rpx;
  border-radius: 12rpx;
  border: none;
  padding: 12rpx 24rpx;
}

.form {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.trad-toggle {
  display: flex;
  align-items: center;
}

.trad-label {
  font-size: 24rpx;
  color: #c9a84c;
  margin-right: -8rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #9999bb;
  margin-bottom: 10rpx;
}

.input {
  background: #1a1a2e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e0d5b0;
  width: calc(100% - 48rpx);
  box-sizing: content-box;
}

.picker-inline-row {
  display: flex;
  gap: 16rpx;
}

.picker-inline-col {
  flex: 1;
  min-width: 0;
}

.col-narrow {
  flex: 2;
}

.col-wide {
  flex: 3;
}

.picker-inline-col .input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 16rpx;
}

.picker-select {
  color: #e0d5b0;
}

.picker-disabled {
  color: #444466;
}

.submit-btn {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

/* 种族色条 */
.race-demon { border-left: 4rpx solid #8b3a4a; }
.race-angel { border-left: 4rpx solid #3a6899; }

.list-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #c9a84c;
  margin-bottom: 20rpx;
}

.empty {
  text-align: center;
  color: #666688;
  font-size: 28rpx;
  margin-top: 40rpx;
}

.signup-card {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 20rpx 16rpx 0;
  margin-bottom: 12rpx;
  position: relative;
  overflow: hidden;
}

.card-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.rank {
  font-size: 36rpx;
  font-weight: bold;
  color: #c9a84c;
  width: 50rpx;
  text-align: center;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.char-name {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #e0d5b0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job {
  display: block;
  font-size: 24rpx;
  color: #9999bb;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.remark {
  display: block;
  font-size: 22rpx;
  color: #666688;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-actions {
  display: flex;
  gap: 10rpx;
}

.copy-btn {
  display: block;
  width: 100% !important;
  margin-top: 16rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #c9a84c;
  background: #0d1628;
  border: none;
  border-top: 1rpx solid #2a2a4a;
  border-radius: 0;
  min-width: 0 !important;
  line-height: 1.6;
  text-align: center;
  box-sizing: border-box;
}

.action-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #3a1a1a;
  color: #cf6679;
  font-size: 22rpx;
  border-radius: 50%;
  border: none;
  padding: 0;
  min-width: 0 !important;
  width: 48rpx !important;
  height: 48rpx;
  line-height: 48rpx;
}

