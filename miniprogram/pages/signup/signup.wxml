<view class="container">

<!-- 房间信息 -->
<view class="room-header">
  <text class="room-name">{{room.name}}</text>
  <text class="room-meta">📍 {{room.dungeonName}}</text>
  <text class="room-meta">⏰ {{room.raidTime}}</text>
  <text class="room-meta">👥 {{signups.length}} / {{room.maxPlayers}} 人</text>
</view>

<!-- 队长工具栏 -->
<view wx:if="{{isLeader}}" class="leader-bar">
  <button class="lock-btn {{room.locked ? 'unlockbtn' : 'lockbtn'}}" bindtap="toggleLock">
    {{room.locked ? '🔓 解锁名单' : '🔒 锁定名单'}}
  </button>
</view>

<!-- 报名按钮 -->
<view wx:if="{{!room.locked}}" class="signup-action">
  <view wx:if="{{!mySignup}}">
    <button class="signup-btn" bindtap="toggleForm">
      {{showForm ? '▲ 收起' : '⚔️ 我要报名'}}
    </button>
  </view>
  <view wx:else class="already-signed">
    <text>✅ 你已报名（{{mySignup.charName}}）</text>
    <button class="cancel-btn" bindtap="cancelSignup">取消报名</button>
  </view>
</view>

<!-- 报名表单 -->
<view wx:if="{{showForm && !mySignup}}" class="form">
  <view class="form-item">
    <view class="picker-inline-row">
      <view class="picker-inline-col col-narrow">
        <text class="label">种族 *</text>
        <picker mode="selector" range="{{raceOptions}}" bindchange="onRaceChange">
          <view class="input picker-select">{{form.race || '请选择种族'}}</view>
        </picker>
      </view>
      <view class="picker-inline-col col-wide">
        <text class="label">服务器 *</text>
        <picker mode="selector" range="{{currentClassOptions}}" bindchange="onClassChange" disabled="{{!form.race}}">
          <view class="input picker-select {{!form.race ? 'picker-disabled' : ''}}">{{form.className || (form.race ? '请选择服务器' : '请选择种族')}}</view>
        </picker>
      </view>
    </view>
  </view>
  <view class="form-item">
    <text class="label">角色名 *</text>
    <input class="input" placeholder="输入你的角色名" data-field="charName" bindinput="onInput" value="{{form.charName}}"/>
  </view>
  <view class="form-item">
    <view class="picker-inline-row">
      <view class="picker-inline-col">
        <text class="label">类型 *</text>
        <picker mode="selector" range="{{jobTypeOptions}}" bindchange="onJobTypeChange">
          <view class="input picker-select">{{form.jobType || '请选择类型'}}</view>
        </picker>
      </view>
      <view class="picker-inline-col">
        <text class="label">职业 *</text>
        <picker mode="selector" range="{{currentJobClassOptions}}" bindchange="onJobClassChange" disabled="{{!form.jobType}}">
          <view class="input picker-select {{!form.jobType ? 'picker-disabled' : ''}}">{{form.jobClass || (form.jobType ? '请选择职业' : '请选择职业')}}</view>
        </picker>
      </view>
    </view>
  </view>
  <view class="form-item">
    <text class="label">装等 *</text>
    <input class="input" placeholder="例如：3000" data-field="power" bindinput="onInput" value="{{form.power}}"/>
  </view>
  <view class="form-item">
    <text class="label">备注</text>
    <input class="input" placeholder="选填" data-field="remark" bindinput="onInput" value="{{form.remark}}"/>
  </view>
  <button class="submit-btn" bindtap="submitSignup">确认报名</button>
</view>

<!-- 名单列表 -->
<view class="signup-list">
  <text class="list-title">📋 当前名单</text>

  <view wx:if="{{signups.length === 0}}" class="empty">
    <text>暂无人报名，快来第一个！</text>
  </view>

  <view
    wx:for="{{signups}}"
    wx:key="_id"
    class="signup-card"
  >
    <button wx:if="{{isLeader}}" class="action-btn kick" catchtap="kickPlayer" data-id="{{item._id}}">✕</button>
    <view class="card-left">
      <text class="rank">{{index + 1}}</text>
      <view class="card-info">
        <text class="char-name">{{item.charName}}</text>
        <text class="job">{{item.race}} · {{item.className}}</text>
        <text class="job">{{item.jobType}} · {{item.jobClass}} · {{item.power}}</text>
        <text wx:if="{{item.remark}}" class="remark">💬 {{item.remark}}</text>
      </view>
    </view>
    <button class="copy-btn" catchtap="copyName" data-name="{{item.charName}}" data-server="{{item.className}}">复制名称</button>
  </view>
</view>

</view>