.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 12rpx;
  box-sizing: border-box;
  width: 100%;
}

.already-card {
  background: linear-gradient(135deg, #1e1a0e, #16213e);
  border: 2rpx solid #c9a84c;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.already-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #c9a84c;
  margin-bottom: 16rpx;
}

.already-info {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 8rpx;
}

.cancel-btn {
  margin-top: 20rpx;
  background: #3a1a1a;
  color: #cf6679;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: none;
}

.form {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 10rpx;
}

.input {
  background: #1a1a2e;
  border: 1rpx solid #2a2a4a;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e0d5b0;
  width: calc(100% - 48rpx);
  box-sizing: content-box;
}

.picker-inline-row {
  display: flex;
  gap: 16rpx;
}

.picker-inline-col {
  flex: 1;
  min-width: 0;
}

.picker-inline-col .input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 16rpx;
}

.col-narrow { flex: 2; }
.col-wide   { flex: 3; }

.label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.label-row .label {
  margin-bottom: 0;
}

.trad-toggle {
  display: flex;
  align-items: center;
}

.trad-label {
  font-size: 24rpx;
  color: #c9a84c;
  margin-right: -8rpx;
}

.picker-select { color: #e0d5b0; }
.picker-disabled { color: #444466; }

.pick-char-btn {
  background: #16213e;
  color: #c9a84c;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 1rpx solid #c9a84c;
  margin-bottom: 24rpx;
}

.submit-btn {
  margin-top: 10rpx;
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}
