<view class="container">

<view class="header">
  <text class="title">{{mode === 'create' ? '创建队伍' : '编辑队伍'}}</text>
</view>

<view class="form">

  <view class="form-item">
    <text class="label">队伍名称</text>
    <input
      class="input"
      placeholder="例如：今晚深渊组队"
      value="{{form.name}}"
      data-field="name"
      bindinput="onInput"
    />
  </view>

  <view class="form-item">
    <text class="label">副本选择</text>
    <picker mode="selector" range="{{dungeonOptions}}" bindchange="onDungeonChange">
      <view class="picker-box picker-left picker-full">{{form.dungeonName || '请选择副本'}}</view>
    </picker>
  </view>

  <view class="form-item">
    <text class="label">开团时间</text>
    <view class="picker-row">
      <picker mode="date" value="{{raidDate}}" bindchange="onDateChange">
        <view class="picker-box picker-full">{{raidDate}}</view>
      </picker>
      <picker mode="time" value="{{raidHour}}" bindchange="onTimeChange">
        <view class="picker-box">{{raidHour}}</view>
      </picker>
    </view>
  </view>

  <view class="form-item">
    <text class="label">人数上限</text>
    <input
      class="input"
      type="number"
      placeholder="例如：8"
      value="{{form.maxPlayers}}"
      data-field="maxPlayers"
      bindinput="onInput"
    />
  </view>

  <button class="submit-btn" bindtap="submitRoom">
    {{mode === 'create' ? '创建队伍' : '保存修改'}}
  </button>

</view>

</view>