.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 12rpx;
  box-sizing: border-box;
  width: 100%;
}

.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #c9a84c;
}

.form {
  margin-top: 20rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 26rpx;
  color: #8888aa;
  margin-bottom: 12rpx;
  letter-spacing: 2rpx;
}

.input {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  font-size: 30rpx;
  color: #e0d5b0;
  width: calc(100% - 60rpx);
  box-sizing: content-box;
}

.picker-row {
  display: flex;
  gap: 16rpx;
}

.picker-box {
  flex: 1;
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 30rpx;
  color: #e0d5b0;
  text-align: center;
  box-sizing: border-box;
}

.picker-left {
  text-align: left;
}

.picker-full {
  width: 100%;
}

.submit-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
  padding: 24rpx 0;
}