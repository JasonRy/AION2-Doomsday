.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 30rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #c9a84c;
  letter-spacing: 4rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #8888aa;
  margin-top: 10rpx;
  letter-spacing: 6rpx;
}

.create-btn-wrap {
  margin: 20rpx 0 30rpx;
}

.create-btn {
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.room-list {
  margin-top: 10rpx;
}

.empty {
  text-align: center;
  color: #666688;
  font-size: 28rpx;
  margin-top: 100rpx;
}

.room-card {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.room-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #2a2a4a;
}

.room-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: bold;
  color: #e0d5b0;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.room-status {
  flex-shrink: 0;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}

.open {
  background: #1a3a2a;
  color: #4caf82;
}

.locked {
  background: #3a1a1a;
  color: #cf6679;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.room-info text {
  font-size: 26rpx;
  color: #8888aa;
}