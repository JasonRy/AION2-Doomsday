.container {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 12rpx;
  box-sizing: border-box;
  width: 100%;
}

.header {
  text-align: center;
  padding: 40rpx 0 30rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #c9a84c;
  letter-spacing: 4rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #9999bb;
  margin-top: 10rpx;
  letter-spacing: 6rpx;
}

.create-btn-wrap {
  margin: 20rpx 0 16rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.action-entry {
  flex: 1;
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  color: #c9a84c;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.create-btn {
  background: linear-gradient(135deg, #c9a84c, #a0722a);
  color: #1a1a2e;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: none;
}

.room-list {
  margin-top: 10rpx;
}

.empty {
  text-align: center;
  color: #666688;
  font-size: 28rpx;
  margin-top: 100rpx;
}

.empty-icon {
  display: block;
  font-size: 28rpx;
  color: #3a3a5a;
  margin-bottom: 24rpx;
  letter-spacing: 8rpx;
}

.empty-sub {
  display: block;
  font-size: 22rpx;
  color: #444466;
  margin-top: 10rpx;
  letter-spacing: 6rpx;
}

.room-card {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.room-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.room-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: bold;
  color: #e0d5b0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delete-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #3a1a1a;
  color: #cf6679;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.room-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.open {
  background: #1a3a2a;
  color: #4caf82;
}

.locked {
  background: #3a1a1a;
  color: #cf6679;
}

.room-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #2a2a4a;
}

.room-info text {
  font-size: 26rpx;
  color: #9999bb;
}

.room-card-expired {
  opacity: 0.5;
}

.expired {
  background: #2a2a3a;
  color: #666688;
}