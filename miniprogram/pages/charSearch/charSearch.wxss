.page-wrap {
  min-height: 100vh;
  background: #1a1a2e;
  padding: 20rpx 16rpx 40rpx;
  box-sizing: border-box;
}

/* 搜索区 */
.search-box {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.server-picker {
  flex-shrink: 0;
}

.picker-btn {
  display: flex;
  align-items: center;
  background: #0f1c35;
  border: 1rpx solid #2a3a5a;
  border-radius: 10rpx;
  padding: 14rpx 16rpx;
  font-size: 26rpx;
  color: #c0c8e0;
  white-space: nowrap;
  gap: 6rpx;
}

.picker-arrow {
  color: #9999bb;
  font-size: 22rpx;
}

.search-input {
  flex: 1;
  background: #0f1c35;
  border: 1rpx solid #2a3a5a;
  border-radius: 10rpx;
  padding: 14rpx 14rpx;
  font-size: 28rpx;
  color: #e0e8ff;
  min-width: 0;
}

.convert-toggle {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.toggle-track {
  width: 72rpx;
  height: 38rpx;
  border-radius: 38rpx;
  background: #2a2a4a;
  border: 1rpx solid #3a3a5a;
  position: relative;
  transition: background 0.2s;
}

.toggle-track.toggle-on {
  background: #1e3a6e;
  border-color: #c9a84c55;
}

.toggle-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #6666aa;
  transition: left 0.2s, background 0.2s;
}

.toggle-on .toggle-thumb {
  left: 38rpx;
  background: #c9a84c;
}

.toggle-label {
  font-size: 24rpx;
  color: #9999bb;
  white-space: nowrap;
}

.search-btn {
  width: 100%;
  background: linear-gradient(135deg, #1e3a6e, #0d2448);
  color: #c9a84c;
  border: 1rpx solid #c9a84c55;
  border-radius: 10rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  min-width: 0 !important;
  line-height: 1.4;
  box-shadow: inset 0 1rpx 0 rgba(201, 168, 76, 0.12);
}

/* 种族筛选 */
.race-filter {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.race-tag {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 10rpx;
  border: 1rpx solid #2a3a5a;
  font-size: 26rpx;
  color: #9999bb;
  background: #0f1c35;
}

.race-tag-active {
  border-color: #c9a84c;
  color: #c9a84c;
  background: #181e35;
}

/* 历史记录 */
.history-section {
  margin-bottom: 20rpx;
}

.history-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx;
  margin-bottom: 10rpx;
}

.history-title {
  font-size: 24rpx;
  color: #6666aa;
  letter-spacing: 2rpx;
}

.history-toggle {
  font-size: 20rpx;
  color: #4a4a6a;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.history-card {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 18rpx 56rpx 18rpx 16rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-left-width: 4rpx;
  position: relative;
}

.history-card.race-angel { border-left-color: #3a6899; }
.history-card.race-demon { border-left-color: #8b3a4a; }

.history-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #0f1c35;
  border: 1rpx solid #2a2a4a;
}

.history-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.history-name {
  font-size: 28rpx;
  color: #e0e8ff;
  font-weight: 500;
}

.history-meta-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.history-server {
  font-size: 22rpx;
  color: #7799cc;
}

.history-sep {
  font-size: 20rpx;
  color: #3a3a5a;
}

.history-class {
  font-size: 22rpx;
  color: #9999bb;
}

.history-cp {
  font-size: 22rpx;
  color: #c9a84c;
  font-weight: 500;
}

.history-level-row {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.history-level {
  font-size: 22rpx;
  color: #9999bb;
}

.history-il {
  font-size: 22rpx;
  color: #7799cc;
}

/* 搜索结果中的头像占位 */
.result-avatar {
  background: #1a2540;
  border: 1rpx dashed #3a3a5a;
}

.result-avatar-angel { border-color: #3a6899; background: #0f1c2e; }
.result-avatar-demon { border-color: #6a2a3a; background: #1e0f18; }

.history-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 10rpx;
}

.history-fav-btn {
  font-size: 30rpx;
  color: #4a4a6a;
  padding: 4rpx 8rpx;
}

.history-fav-btn.fav-active {
  color: #c9a84c;
}

.history-del-btn {
  font-size: 24rpx;
  color: #4a4a6a;
  padding: 4rpx 8rpx;
}

/* 结果列表 */
.result-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

/* 角色卡片 */
.char-card {
  background: #16213e;
  border: 1rpx solid #2a2a4a;
  border-radius: 12rpx;
  padding: 28rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-left-width: 4rpx;
}

.char-card.race-angel { border-left-color: #3a6899; }
.char-card.race-demon { border-left-color: #8b3a4a; }

.char-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.char-name {
  font-size: 30rpx;
  color: #e0e8ff;
  font-weight: 500;
}

.char-class {
  font-size: 24rpx;
  color: #9999bb;
}

.char-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.char-race { font-size: 24rpx; }
.race-angel-text { color: #6aacdd; }
.race-demon-text { color: #c0607a; }

.char-level {
  font-size: 24rpx;
  color: #9999bb;
}

.char-arrow {
  font-size: 36rpx;
  color: #4a4a6a;
  line-height: 1;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.empty-icon {
  font-size: 28rpx;
  color: #3a3a5a;
  letter-spacing: 8rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #4a4a6a;
}

/* 加载中 */
.loading-state {
  text-align: center;
  padding: 80rpx 0;
  color: #9999bb;
  font-size: 28rpx;
}

/* 详情弹层 */
.detail-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.detail-panel {
  width: 100%;
  background: #131a2e;
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1rpx solid #2a2a4a;
  padding: 0 0 60rpx;
  max-height: 88vh;
  overflow-y: auto;
  box-sizing: border-box;
}

.detail-close-row {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 24rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  background: #131a2e;
  border-radius: 24rpx 24rpx 0 0;
}

.detail-close-btn {
  font-size: 34rpx;
  color: #6666aa;
  padding: 8rpx 12rpx;
}

/* Profile 卡片 */
.profile-card {
  display: flex;
  align-items: stretch;
  padding: 24rpx 24rpx 28rpx;
  border-bottom: 1rpx solid #1e2a42;
  gap: 16rpx;
}

.profile-angel { border-left: 4rpx solid #3a6899; }
.profile-demon { border-left: 4rpx solid #8b3a4a; }

.profile-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.profile-meta-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 4rpx;
}

.p-server {
  font-size: 22rpx;
  color: #9999bb;
}

.p-dot {
  font-size: 20rpx;
  color: #4a4a6a;
}

.p-race {
  font-size: 22rpx;
  font-weight: 500;
}

.p-rank {
  font-size: 22rpx;
  color: #c9a84c;
}

.p-class {
  font-size: 24rpx;
  color: #7799cc;
  margin-bottom: 6rpx;
}

.p-name {
  font-size: 48rpx;
  color: #e8eeff;
  font-weight: bold;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.p-title {
  font-size: 24rpx;
  margin-bottom: 14rpx;
}

.grade-text-Legend { color: #e6c84a; }
.grade-text-Unique { color: #b07ed4; }
.grade-text-Epic   { color: #5b9bd5; }
.grade-text-Special { color: #5cb85c; }

.p-stats {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.p-stat-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.p-stat-lbl {
  font-size: 22rpx;
  color: #6666aa;
}

.p-stat-val {
  font-size: 28rpx;
  color: #c0c8e0;
  font-weight: 600;
}

.p-stat-val.gold { color: #c9a84c; }
.gold { color: #c9a84c; }

.p-stat-sep {
  font-size: 22rpx;
  color: #3a3a5a;
}

/* 头像 */
.profile-right {
  flex-shrink: 0;
  display: flex;
  align-items: stretch;
}

.profile-avatar {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: #0f1c35;
  border: 2rpx solid #2a2a4a;
}

/* 装备列表 */
.equip-section {
  padding: 24rpx;
}

.section-ttl {
  font-size: 24rpx;
  color: #6666aa;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 16rpx;
}

.equip-list {
  display: flex;
  flex-direction: column;
}

.equip-item-wrap {
  border-bottom: 1rpx solid #1e2a42;
}

.equip-item-wrap:last-child {
  border-bottom: none;
}

.equip-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 0;
}

.equip-icon-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.equip-cell {
  width: 96rpx;
  height: 96rpx;
  background: #0f1c35;
  border-radius: 8rpx;
  border: 2rpx solid #2a2a4a;
  overflow: hidden;
}

.godstone-btn {
  width: 64rpx;
  height: 64rpx;
  background: #0d1628;
  border: 1rpx solid #3a3a6a;
  border-radius: 6rpx;
  position: relative;
  overflow: visible;
}

.godstone-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 6rpx;
  overflow: hidden;
  display: block;
}

.godstone-popup {
  display: none;
  position: absolute;
  left: 70rpx;
  top: 0;
  width: 280rpx;
  background: #1a2540;
  border: 1rpx solid #3a4a6a;
  border-radius: 8rpx;
  padding: 10rpx 12rpx;
  z-index: 50;
  flex-direction: column;
  gap: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.6);
}

.godstone-active .godstone-popup {
  display: flex;
}

.godstone-popup-name {
  font-size: 22rpx;
  color: #c9a84c;
  font-weight: 500;
  margin-bottom: 4rpx;
}

.godstone-popup-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.godstone-popup-stat {
  font-size: 22rpx;
  color: #9999bb;
}

.godstone-popup-val {
  font-size: 22rpx;
  color: #7ecba0;
}

.equip-stats {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.equip-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 2rpx;
}

.equip-enchant-tag {
  font-size: 22rpx;
  color: #f0d060;
  font-weight: bold;
}

.equip-exceed-tag {
  font-size: 20rpx;
  color: #fff;
  background: #c0501a;
  border-radius: 4rpx;
  padding: 1rpx 6rpx;
  font-weight: bold;
  line-height: 1.4;
}

.equip-item-name {
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
}

.equip-slot-name {
  font-size: 22rpx;
  color: #6666aa;
  margin-bottom: 4rpx;
}

.equip-section-ttl {
  font-size: 20rpx;
  color: #5577aa;
  letter-spacing: 1rpx;
  margin: 6rpx 0 2rpx;
  display: block;
}

.equip-stats-cols {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
}

.equip-stats-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.equip-stats-right {
  width: 160rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  border-left: 1rpx solid #2a2a4a;
  padding-left: 10rpx;
}

.magic-stone-ttl {
  font-size: 20rpx;
  color: #9b6ec8;
  letter-spacing: 1rpx;
  margin-bottom: 4rpx;
  display: block;
}

.eq-stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 3rpx 6rpx;
  border-radius: 4rpx;
}

.exceed-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 6rpx 0 2rpx;
}

.exceed-label {
  font-size: 20rpx;
  color: #c0501a;
  background: rgba(192, 80, 26, 0.15);
  border: 1rpx solid rgba(192, 80, 26, 0.4);
  border-radius: 4rpx;
  padding: 1rpx 8rpx;
  font-weight: 500;
}

.exceed-stat {
  background: rgba(201, 168, 76, 0.06);
  border-left: 2rpx solid rgba(201, 168, 76, 0.35);
  padding-left: 8rpx;
  border-radius: 0 4rpx 4rpx 0;
}

.stat-name-exceed {
  font-size: 22rpx;
  color: #c9a84c;
}

.exceed-val-wrap {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-value-exceed {
  font-size: 24rpx;
  color: #e8c84a;
  font-weight: 600;
}

.stat-extra-exceed {
  font-size: 20rpx;
  color: #f0d060;
  background: rgba(240, 208, 96, 0.12);
  border-radius: 3rpx;
  padding: 1rpx 5rpx;
}

.soul-section {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 2rpx;
}

.stat-value-soul {
  font-size: 24rpx;
  color: #c9a84c;
  font-weight: 500;
}

.sources-row {
  display: flex;
  align-items: flex-start;
  gap: 6rpx;
  margin-top: 6rpx;
  flex-wrap: wrap;
}

.sources-label {
  font-size: 20rpx;
  color: #5577aa;
  flex-shrink: 0;
}

.sources-val {
  font-size: 20rpx;
  color: #7799cc;
}


.border-Legend  { border-color: #e6c84a; }
.border-Unique  { border-color: #9b6ec8; }
.border-Epic    { border-color: #4a7fc1; }
.border-Special { border-color: #4a9e5c; }

.equip-icon {
  width: 100%;
  height: 100%;
}


/* 加载/失败 */
.detail-loading, .detail-error {
  text-align: center;
  padding: 80rpx 0;
  color: #9999bb;
  font-size: 28rpx;
}

.main-stat {
  background: #0f1c35;
}

.sub-stat {
  background: transparent;
}

.stat-name {
  font-size: 22rpx;
  color: #9999bb;
}

.stat-value-main {
  font-size: 24rpx;
  color: #e0e8ff;
  font-weight: 500;
}

.stat-extra {
  font-size: 20rpx;
  color: #c9a84c;
}

.stat-value-sub {
  font-size: 22rpx;
  color: #7ecba0;
}

.stat-divider {
  height: 1rpx;
  background: #2a2a4a;
  margin: 8rpx 0;
}

.equip-detail-loading {
  text-align: center;
  padding: 40rpx 0;
  color: #9999bb;
  font-size: 26rpx;
}

/* ── 通用详情分区 ── */
.detail-section {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #1e2a42;
}

.detail-section-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.detail-section-ttl {
  font-size: 22rpx;
  color: #5577aa;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 14rpx;
}

.detail-section-sub {
  font-size: 20rpx;
  color: #4a5a7a;
}

/* ── 能力值 ── */
.stat-basic-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.stat-basic-item {
  width: calc(33.33% - 8rpx);
  background: #0f1c35;
  border: 1rpx solid #2a3a5a;
  border-radius: 8rpx;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
}

.stat-basic-type {
  font-size: 20rpx;
  color: #5577aa;
}

.stat-basic-val {
  font-size: 30rpx;
  color: #e0e8ff;
  font-weight: 600;
}

.stat-secondary-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stat-sec-item {
  width: calc(20% - 9rpx);
  background: #0f1c35;
  border: 1rpx solid #2a3a5a;
  border-radius: 8rpx;
  padding: 10rpx 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
}

.stat-item-active {
  border-color: #c9a84c55;
  background: #1a2540;
}

.stat-popup {
  display: none;
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  background: #1a2540;
  border: 1rpx solid #3a4a6a;
  border-radius: 6rpx;
  padding: 10rpx 14rpx;
  z-index: 30;
  flex-direction: column;
  gap: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.7);
}

.stat-item-active .stat-popup {
  display: flex;
}

.stat-popup-line {
  font-size: 20rpx;
  color: #7ecba0;
  white-space: nowrap;
}

.stat-sec-name {
  font-size: 20rpx;
  color: #7799bb;
}

.stat-sec-val {
  font-size: 26rpx;
  color: #c9a84c;
  font-weight: 600;
}

/* ── 守护力 ── */
.daev-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.daev-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.daev-icon {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  background: #0f1c35;
  border-radius: 6rpx;
}

.daev-info {
  flex: 1;
  min-width: 0;
}

.daev-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 6rpx;
}

.daev-name {
  font-size: 24rpx;
  color: #c0c8e0;
}

.daev-count {
  font-size: 20rpx;
  color: #6677aa;
}

.daev-bar-wrap {
  height: 8rpx;
  background: #1e2a42;
  border-radius: 4rpx;
  overflow: hidden;
}

.daev-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3a6899, #c9a84c);
  border-radius: 4rpx;
}

/* ── 称号 ── */
.title-group {
  margin-bottom: 16rpx;
}

.title-group-label {
  font-size: 20rpx;
  color: #4a5a7a;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.title-list {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.title-item {
  background: #0f1c35;
  border-radius: 8rpx;
  padding: 10rpx 14rpx;
  display: flex;
  align-items: center;
  position: relative;
  overflow: visible;
}

.title-name {
  font-size: 24rpx;
  font-weight: 500;
  flex: 1;
}

.title-owned {
  font-size: 20rpx;
  color: #4a5a7a;
  flex-shrink: 0;
}

.title-grade-Legend { color: #e6c84a; }
.title-grade-Unique { color: #c9a84c; }
.title-grade-Epic   { color: #5b9bd5; }
.title-grade-Special { color: #e0e8ff; }
.title-grade-Normal { color: #7a7a8a; }

.title-popup {
  display: none;
  position: absolute;
  left: 0;
  top: 100%;
  background: #1a2540;
  border: 1rpx solid #3a4a6a;
  border-radius: 6rpx;
  padding: 10rpx 14rpx;
  z-index: 20;
  flex-direction: column;
  gap: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.6);
}

.title-item-active .title-popup {
  display: flex;
}

.title-popup-stat {
  font-size: 20rpx;
  color: #7ecba0;
  display: block;
}

/* ── 技能 ── */
.skill-group-ttl {
  font-size: 20rpx;
  color: #4a5a7a;
  display: block;
  margin: 10rpx 0 8rpx;
  letter-spacing: 1rpx;
}

.skill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.skill-item {
  width: calc(20% - 9rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 4rpx;
  background: #0f1c35;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.skill-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 8rpx;
  background: #131a2e;
}

.skill-name {
  font-size: 20rpx;
  color: #c0c8e0;
  text-align: center;
  line-height: 1.3;
}

.skill-level {
  font-size: 20rpx;
  color: #c9a84c;
}

/* 攻擊力分析 — summary card */
.atk-card {
  background: #16213e;
  border: 1rpx solid #2a3a5a;
  border-radius: 12rpx;
  padding: 20rpx;
}
.atk-card-hd {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.atk-card-hint {
  font-size: 22rpx;
  color: #c9a84c;
}
.atk-card-body {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}
.atk-card-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.atk-card-lbl {
  font-size: 20rpx;
  color: #7080a0;
}
.atk-card-num {
  font-size: 32rpx;
  color: #c0d0f0;
  font-weight: bold;
}
.atk-card-gold {
  color: #e6c84a;
  font-size: 36rpx;
}
.atk-card-op {
  font-size: 22rpx;
  color: #8090b0;
}
.atk-card-eq {
  font-size: 24rpx;
  color: #8090b0;
  font-weight: bold;
}

/* 攻擊力詳情疊層 */
.atk-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: #0d1628;
  z-index: 200;
  display: flex;
  flex-direction: column;
}
.atk-ov-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 20rpx;
  background: #131a2e;
  border-bottom: 1rpx solid #2a2a4a;
  flex-shrink: 0;
}
.atk-ov-back {
  font-size: 30rpx;
  color: #c9a84c;
  padding: 4rpx 8rpx;
  min-width: 80rpx;
}
.atk-ov-title {
  font-size: 30rpx;
  color: #e0e8ff;
  font-weight: bold;
}
.atk-ov-hd-r {
  min-width: 80rpx;
}
.atk-ov-sum {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: #131a2e;
  border-bottom: 1rpx solid #1e2540;
  flex-shrink: 0;
  flex-wrap: wrap;
}
.atk-os-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}
.atk-os-lbl {
  font-size: 20rpx;
  color: #6070a0;
}
.atk-os-val {
  font-size: 30rpx;
  color: #c0d0f0;
  font-weight: bold;
}
.atk-os-gold {
  color: #e6c84a;
  font-size: 34rpx;
}
.atk-os-op {
  font-size: 22rpx;
  color: #8090b0;
}
.atk-os-eq {
  font-size: 24rpx;
  color: #8090b0;
  font-weight: bold;
}
.atk-ov-scroll {
  flex: 1;
  height: 0;
}
.atk-group {
  margin: 0 16rpx 8rpx;
  background: #131a2e;
  border-radius: 10rpx;
  border: 1rpx solid #1e2a42;
  overflow: hidden;
}
.atk-group-hd {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  gap: 12rpx;
}
.atk-group-info {
  flex: 1;
  min-width: 0;
}
.atk-group-lbl {
  display: block;
  font-size: 26rpx;
  color: #c0d0f0;
  font-weight: bold;
}
.atk-group-item {
  display: block;
  font-size: 20rpx;
  color: #5a6a90;
  margin-top: 2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.atk-group-subs {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
  flex-shrink: 0;
}
.atk-group-sub-flat {
  font-size: 24rpx;
  color: #c9a84c;
  font-weight: bold;
}
.atk-group-sub-pct {
  font-size: 20rpx;
  color: #7ab0e0;
}
.atk-group-arrow {
  font-size: 20rpx;
  color: #6070a0;
  flex-shrink: 0;
}
.atk-group-body {
  border-top: 1rpx solid #1e2a42;
  padding: 4rpx 0;
}
.atk-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 24rpx;
  border-bottom: 1rpx solid #181f35;
}
.atk-entry-lbl {
  font-size: 22rpx;
  color: #8090b0;
  flex: 1;
}
.atk-entry-val {
  font-size: 24rpx;
  color: #e6c84a;
  font-weight: bold;
  flex-shrink: 0;
}
.atk-entry-pct {
  color: #7ab0e0;
}
.atk-ov-pad {
  height: 60rpx;
}
