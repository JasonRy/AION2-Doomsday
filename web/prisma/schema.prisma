generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts   OAuthAccount[]
  templates  PetTemplate[]
  queryLogs  CharacterQueryLog[]
  snapshots  CharacterSnapshot[]
}

model OAuthAccount {
  id             Int      @id @default(autoincrement())
  userId         Int
  provider       String
  providerUserId String
  email          String?
  name           String?
  avatarUrl      String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model PetTemplate {
  id        Int      @id @default(autoincrement())
  userId    Int
  slotIndex Int
  name      String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slotIndex])
}

model CharacterQueryLog {
  id             Int      @id @default(autoincrement())
  userId         Int?
  characterId    String
  characterName  String
  serverId       Int?
  serverName     String?
  race           Int?
  className      String?
  level          Int?
  combatPower    Int?
  itemLevel      Int?
  snapshotType   String?
  querySource    String
  queryKeyword   String?
  clientIpHash   String?
  userAgentHash  String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([characterId, serverId])
  @@index([querySource])
  @@index([createdAt])
}

model CharacterSnapshot {
  id             Int      @id @default(autoincrement())
  userId         Int?
  characterId    String
  characterName  String
  serverId       Int?
  serverName     String?
  race           Int?
  className      String?
  level          Int?
  combatPower    Int?
  itemLevel      Int?
  snapshotType   String?
  profileJson    Json?
  equipmentJson  Json?
  analysisJson   Json?
  detailJson     Json?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([characterId, serverId])
  @@index([snapshotType])
  @@index([createdAt])
}

model CharacterNameSnapshot {
  id             Int      @id @default(autoincrement())
  characterId    String
  serverId       Int
  characterName  String
  serverName     String?
  race           Int?
  className      String?
  level          Int?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @updatedAt
  seenCount      Int      @default(1)

  @@unique([characterId, serverId, characterName])
  @@index([characterId, serverId])
  @@index([characterName])
  @@index([lastSeenAt])
}
